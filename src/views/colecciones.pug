html 
    head 
        title Mis Colecciones
    body 
        h1 Mis Colecciones de #{nickUsuario}

        div(style="margin-bottom: 20px;")
            a(href="/usuario/colecciones/nueva" style="padding: 8px 16px; background-color: #28a745; color: white; text-decoration: none; border-radius: 4px;") Crear Nueva Colección

        if colecciones && colecciones.length > 0
            div(style="display: flex; flex-wrap: wrap; gap: 20px;")
                each col in colecciones
                    a(href=`/usuario/colecciones/${encodeURIComponent(col.nickColeccion)}` style="text-decoration: none; color: inherit;")
                        div(style="border: 1px solid #ccc; padding: 15px; border-radius: 8px; text-align: center; width: 250px; cursor: pointer;")
                            h3= col.nickColeccion
                            if col.imagen
                                img(src=col.imagen.url, alt=`Ultima imagen en ${col.nickColeccion}`, style="max-width: 100%; border-radius: 4px; max-height: 200px; object-fit: cover;")
                            else
                                p Sin imagenes
        else 
            p Aún no tienes colecciones guardadas.
        
        div(style="margin-top: 30px;")
            a(href=`/usuario/perfil/${nickUsuario}`) Volver a mi perfil
