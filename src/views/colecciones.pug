extends layouts/app

block content
  .d-flex.justify-between.align-center.mb-6
    h1.page-title Mis Colecciones de #{nickUsuario}
    
    a.btn.btn-primary(href="/usuario/colecciones/nueva") Crear Nueva Colección

  if colecciones && colecciones.length > 0
    .gallery-grid
      each col in colecciones
        a.card(href=`/usuario/colecciones/${encodeURIComponent(col.nickColeccion)}`)
          .card-image-wrapper
            if col.imagen
              img.card-image(src=col.imagen.url, alt=`Ultima imagen en ${col.nickColeccion}`)
            else
              .d-flex.align-center.justify-center(style="height: 100%; color: var(--text-muted);") Sin imágenes
          .card-content
            h3.card-title= col.nickColeccion
  else 
    .empty-state
      .empty-state-title Sin colecciones
      p.text-muted Aún no tienes colecciones guardadas.
