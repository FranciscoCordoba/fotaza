extends layouts/app

block content
  .profile-header
    .profile-avatar
      if perfil.nickname
        | #{perfil.nickname.charAt(0).toUpperCase()}
    .profile-info
      h1.page-title.mb-4 Perfil de #{perfil.nickname}
      .d-flex.gap-6.text-body.text-secondary
        span <strong>#{cantidadSeguidores}</strong> Seguidores
        span <strong>#{cantidadSeguidos}</strong> Seguidos
    
    .profile-actions
      if !esPropio && nickUsuarioLogueado
        if siguiendo
          form(action="/usuario/dejar_seguir", method="POST")
            input(type="hidden", name="nickSeguido", value=perfil.nickname)
            button.btn.btn-secondary(type="submit") Dejar de Seguir
        else
          form(action="/usuario/seguir", method="POST")
            input(type="hidden", name="nickSeguido", value=perfil.nickname)
            button.btn.btn-primary(type="submit") Seguir
      
      if esPropio 
        .d-flex.gap-4
          a.btn.btn-secondary(href="/usuario/colecciones") Ver mis colecciones
          a.btn.btn-secondary(href="/usuario/notificaciones") Mis Notificaciones
          a.btn.btn-secondary(href="/chat") Mis Chats

  h2.section-title.mb-6 Publicaciones 
  
  if publicaciones && publicaciones.length > 0
    .gallery-grid
      each pub in publicaciones
        a.card(href=`/publicacion/p/${pub.id}/1`)
          if pub.imagen
            .card-image-wrapper
              img.card-image(src=pub.imagen.url, alt=pub.titulo)
          else
            .card-image-wrapper(style="display: flex; align-items: center; justify-content: center;")
              span.text-muted Sin imagen
          .card-content
            h3.card-title= pub.titulo
            p.text-metadata= pub.descripcion
  else 
    .empty-state
      .empty-state-title Sin publicaciones
      p.text-muted Este usuario no tiene publicaciones.
