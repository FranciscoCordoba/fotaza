html 
    head 
        title Perfil de #{perfil.nickname}
    body 
        h1 Perfil de #{perfil.nickname}

        if !esPropio && nickUsuarioLogueado
            if siguiendo
                form(action="/usuario/dejar_seguir", method="POST")
                    input(type="hidden", name="nickSeguido", value=perfil.nickname)
                    button(type="submit") Dejar de Seguir
            else
                form(action="/usuario/seguir", method="POST")
                    input(type="hidden", name="nickSeguido", value=perfil.nickname)
                    button(type="submit") Seguir

        if esPropio 
            div(style="margin-top: 15px; margin-bottom: 15px; display: flex; gap: 15px;")
                a(href="/usuario/colecciones" style="padding: 8px 16px; background-color: #007bff; color: white; text-decoration: none; border-radius: 4px;") Ver mis colecciones
                a(href="/usuario/notificaciones" style="padding: 8px 16px; background-color: #17a2b8; color: white; text-decoration: none; border-radius: 4px;") Mis Notificaciones

        h2 Publicaciones 
        if publicaciones && publicaciones.length > 0
            ul
                each pub in publicaciones
                    li 
                        h3= pub.titulo
                        p= pub.descripcion
                        if pub.imagen
                            img(src=pub.imagen.url, alt=pub.titulo, width="200")
                            br
                        a(href=`/publicacion/p/${pub.id}/1`) Ver publicacion
        else 
            p Este usuario no tiene publicaciones.
