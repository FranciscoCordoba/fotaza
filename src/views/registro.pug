extends layouts/auth

block content
  .auth-card
    h1.auth-brand Fotaza
    h2.card-title.text-center.mb-6 Registro de Usuario
    
    if error
      .alert.alert-danger= error
      
    form(action="/auth/registro", method="POST")
      .form-group
        label.form-label(for="nickname") Nickname
        input.form-control(type="text", name="nickname", required)
      .form-group
        label.form-label(for="correo") Correo electrónico
        input.form-control(type="email", name="correo", required)
      .form-group
        label.form-label(for="nombre") Nombre completo
        input.form-control(type="text", name="nombre", required)
      .form-group
        label.form-label(for="password") Contraseña
        input.form-control(type="password", name="password", required)
        
      button.btn.btn-primary.btn-block.mt-4(type="submit") Registrarse
      
    .text-center.mt-4
      a.text-secondary(href="/auth/login") Ya tengo cuenta (Iniciar sesión)
