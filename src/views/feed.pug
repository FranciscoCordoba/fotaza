extends layouts/app

block content
  .d-flex.justify-between.align-center.mb-6
    h1.page-title= titulo || 'Todas las publicaciones'
    
    if titulo === 'Feed de Comunidades Seguidas'
      a.btn.btn-primary(href="/comunidad/crear") Crear comunidad
    else
      a.btn.btn-primary(href="/publicacion/crear") Subir nueva publicación

  .nav-tabs
    a.nav-tab(href="/feed", class=(!titulo || titulo === 'Todas las publicaciones' ? 'active' : '')) Feed Global
    a.nav-tab(href="/feed/siguiendo", class=(titulo && titulo.includes('seguidos') ? 'active' : '')) Feed Siguiendo
    a.nav-tab(href="/feed/comunidades", class=(titulo === 'Feed de Comunidades Seguidas' ? 'active' : '')) Feed Comunidades

  form.mb-6.card(action="/publicacion/buscar", method="GET" style="padding: 24px;")
    h2.section-title.mb-4(style="font-size: 1.25rem;") Explorar Publicaciones
    .d-flex.flex-wrap.gap-4.align-end
      .flex-1(style="min-width: 200px;")
        label.text-label(style="display: block; margin-bottom: 8px;") Título o Descripción
        input.form-control(type="text", name="busqueda", placeholder="Ej: Paisaje...", value=busqueda || '')
      
      .flex-1(style="min-width: 200px;")
        label.text-label(style="display: block; margin-bottom: 8px;") Autor (Nickname)
        input.form-control(type="text", name="autor", placeholder="Ej: juan123", value=autor || '')
      
      .flex-1(style="min-width: 200px;")
        label.text-label(style="display: block; margin-bottom: 8px;") Etiqueta
        input.form-control(type="text", name="etiqueta", placeholder="Ej: #naturaleza", value=etiqueta || '')

      .flex-1(style="min-width: 200px;")
        label.text-label(style="display: block; margin-bottom: 8px;") Ordenar por
        select.form-control(name="orden")
          option(value="recientes" selected=(orden==='recientes' || !orden)) Más recientes
          option(value="antiguas" selected=(orden==='antiguas')) Más antiguas

      button.btn.btn-primary(type="submit" style="height: 48px; padding: 0 32px;") Buscar

  if publicaciones && publicaciones.length > 0
    .gallery-grid
      each publicacion in publicaciones 
        a.card(href=`/publicacion/p/${publicacion.id}/1`)
          .card-image-wrapper
            if publicacion.imagen
              img.card-image(src=publicacion.imagen.url, alt=publicacion.titulo)
            else
              .d-flex.align-center.justify-center(style="height: 100%; color: var(--text-muted);") Sin imagen
          .card-content
            h3.card-title= publicacion.titulo
            if publicacion.descripcion
              p.text-body(style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;")= publicacion.descripcion
            if publicacion.comunidadOrigen
              p.text-metadata(style="color: var(--primary); font-weight: 600;") Comunidad: #{publicacion.comunidadOrigen}
            p.text-metadata Por #{publicacion.nickUsuario}
            if publicacion.etiquetas && publicacion.etiquetas.length > 0
              .tag-list.mt-4
                each etiqueta in publicacion.etiquetas
                  span.tag ##{etiqueta.etiqueta}
  else
    .empty-state
      h2.empty-state-title No hay publicaciones
      p.text-secondary No se encontraron publicaciones en este feed.