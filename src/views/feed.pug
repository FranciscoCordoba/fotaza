html 
    head 
        title Feed 

    body 

        form(action="/publicacion/buscar", method="GET")
            input(type="text", name="busqueda", placeholder="Buscar")
            button Buscar 

        div(style="margin-bottom: 10px;")
            a(href="/feed", style="margin-right: 10px;") Feed Global
            a(href="/feed/siguiendo") Feed Siguiendo

        h1= titulo || 'Todas las publicaciones'

        button(onclick="window.location.href = '/publicacion/crear'") Subir nueva publicacion

        .publicaciones
            each publicacion in publicaciones 
                div.publicacion(style="border:1px solid black;margin: 5px;")
                    p #{publicacion.nickUsuario} - #{publicacion.titulo}
                    p #{publicacion.descripcion}
                    if publicacion.etiquetas && publicacion.etiquetas.length > 0
                        p(style="margin: 5px 0; font-size: 0.85em; color: #666;")
                            each etiqueta in publicacion.etiquetas
                                span(style="margin-right: 5px; background-color: #f0f0f0; padding: 2px 6px; border-radius: 4px; display: inline-block;") ##{etiqueta.etiqueta}
                    if publicacion.imagen
                        img(src=publicacion.imagen.url, alt=publicacion.titulo, style="width: 200px; display: block; margin-top: 5px;")
                    button(onclick="window.location.href = 'publicacion/p/" + publicacion.id + "/1'", style="margin-top: 5px;") Ver