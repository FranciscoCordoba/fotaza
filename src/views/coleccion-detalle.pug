extends layouts/app

block content
  .d-flex.justify-between.align-center.mb-6
    div
      h1.page-title(style="margin-bottom: 8px;") Colección: #{nickColeccion}
      p.text-metadata Usuario: #{nickUsuario}
    
    a.btn.btn-secondary(href=`/usuario/colecciones`) Volver a mis colecciones

  if publicaciones && publicaciones.length > 0
    .gallery-grid
      each pub in publicaciones
        .card
          a(href=`/publicacion/p/${pub.id}/1` style="display:block; text-decoration: none; color: inherit;")
            .card-image-wrapper
              if pub.imagen
                img.card-image(src=pub.imagen.url, alt=`Imagen de ${pub.titulo}`)
              else
                .d-flex.align-center.justify-center(style="height: 100%; color: var(--text-muted);") Sin imágenes
            .card-content
              h3.card-title= pub.titulo
              p.text-body(style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;")= pub.descripcion
          if nickColeccion !== 'Favoritos'
            form(action=`/usuario/colecciones/${nickColeccion}/eliminar` method="POST" style="padding: 0 16px 16px;")
              input(type="hidden" name="idPublicacion" value=pub.id)
              button.btn.btn-danger.btn-block(type="submit") Eliminar
  else 
    .empty-state
      .empty-state-title Sin publicaciones
      p.text-muted No hay publicaciones en esta colección.

  if nickColeccion !== 'Favoritos'
    h2.section-title.mt-6 Agregar Publicaciones a esta Colección
    if publicacionesFav && publicacionesFav.length > 0
      form(action=`/usuario/colecciones/${nickColeccion}/agregar` method="POST")
        .gallery-grid
          each pub in publicacionesFav
            label.card(style="cursor: pointer; display: block;")
              .card-content.d-flex.align-center.gap-2(style="padding-bottom: 0;")
                input(type="checkbox" name="publicaciones" value=pub.id)
                h4.card-title= pub.titulo
              if pub.imagen
                .card-image-wrapper.mt-4
                  img.card-image(src=pub.imagen.url, alt=pub.titulo)
        .mt-4
          button.btn.btn-primary(type="submit") Agregar Seleccionadas
    else
      .alert.alert-info(style="margin-top: 16px; background-color: var(--surface-low); border: 1px solid var(--border);") No hay publicaciones nuevas en Favoritos disponibles para agregar.
