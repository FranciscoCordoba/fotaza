extends layouts/app.pug

block content
  .profile-header(style="margin-bottom: 24px;")
    .profile-info
      h1.page-title.mb-0 Denunciar Imagen
      
  if error
    .alert.alert-danger= error

  if yaDenunciado
    .alert.alert-danger Ya has denunciado esta imagen.
    a.btn.btn-secondary.mt-4(href=`/publicacion/p/${publicacion.id}/${imagen.orden}`) Volver a la publicación
  else
    div(style="max-width: 520px;")
      p.text-body.mb-4 Estás a punto de denunciar la siguiente imagen:
      .card-image-wrapper(style="max-width: 100%; border-radius: 8px; margin-bottom: 24px;")
        img.card-image(src=imagen.url, alt="Imagen a denunciar", style="object-fit: contain;")
      
      form(action=`/publicacion/imagen/${imagen.id}/denunciar`, method="POST")
        .form-group
          label.form-label(for="idMotivo") Motivo de la denuncia:
          select.form-control(name="idMotivo" id="idMotivo" required)
            each motivo in motivos
              option(value=motivo.id) #{motivo.motivo}
        
        .form-group
          label.form-label(for="descripcion") Descripción (opcional):
          textarea.form-control(name="descripcion" id="descripcion" placeholder="Proporciona más detalles...")
        
        .d-flex.gap-4.mt-6
          button.btn.btn-danger(type="submit") Confirmar Denuncia
          a.btn.btn-secondary(href=`/publicacion/p/${publicacion.id}/${imagen.orden}`) Cancelar
