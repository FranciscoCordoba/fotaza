extends layouts/app

block content
  .pub-detail-container
    // Left side: Image and navigation
    .pub-detail-image-section
      if imagen
        .d-flex.align-center.gap-4(style="width: 100%; justify-content: center; min-width: 0;")
          if prev
            a.btn.btn-secondary(href=`/publicacion/p/${publicacion.id}/${prev.orden}`, title="Anterior", style="flex-shrink: 0;")
              | &larr;
          img.pub-detail-image(src=imagen.url, alt=publicacion.titulo)
          if post
            a.btn.btn-secondary(href=`/publicacion/p/${publicacion.id}/${post.orden}`, title="Siguiente", style="flex-shrink: 0;")
              | &rarr;
      else
        .empty-state
          .empty-state-title Sin Imágenes
          p No hay imagenes

    // Right side: Info, author, actions, comments
    .pub-detail-sidebar
      // Author and follow logic
      .d-flex.justify-between.align-center
        .d-flex.align-center.gap-2
          .profile-avatar(style="width: 40px; height: 40px; font-size: 16px;")
            if publicacion.nickUsuario
              | #{publicacion.nickUsuario.charAt(0).toUpperCase()}
          span.text-label #{publicacion.nickUsuario}
        
        if publicacion.nickUsuario != nickUsuario
          if siguiendo
            form(action="/usuario/dejar_seguir" method="post")
              input(type="hidden" name="nickSeguido" value=publicacion.nickUsuario)
              button.btn.btn-secondary(type="submit") Dejar de seguir
          else
            form(action="/usuario/seguir" method="post")
              input(type="hidden" name="nickSeguido" value=publicacion.nickUsuario)
              button.btn.btn-primary(type="submit") Seguir

      // Title & Desc
      h1.card-title.mt-4 #{publicacion.titulo}
      p.text-body.text-secondary #{publicacion.descripcion}

      // Tags
      if etiquetas && etiquetas.length > 0
        .tag-list.mt-4
          each etiqueta in etiquetas
            span.tag ##{etiqueta.etiqueta}

      // Actions (Favorite)
      if nickUsuario
        .mt-4
          form(action=`/publicacion/${publicacion.id}/favorito` method="post")
            if enFavoritos
              button.btn.btn-secondary.btn-block(type="submit") ★ Quitar de Favoritos
            else
              button.btn.btn-secondary.btn-block(type="submit") ☆ Guardar en Favoritos
      
      // Image Specific Actions (if imagen)
      if imagen
        if publicacion.nickUsuario == nickUsuario && !imagen.copyright
          .card.card-content.mt-6
            h3.card-title.mb-4 Proteger Imagen
            form.d-flex.gap-2(action=`/publicacion/imagen/${imagen.id}/copyright` method="POST")
              input.form-control.flex-1(type="text", name="textoMarcaDeAgua", placeholder="ej: © 2026 Autor", required)
              button.btn.btn-primary(type="submit") Aplicar
        
        if publicacion.nickUsuario != nickUsuario
          .d-flex.align-center.gap-4.mt-6
            button.btn.btn-danger(type="button" onclick=`window.location.href = '/publicacion/imagen/${imagen.id}/denunciar'`) Denunciar Imagen
            if imagen.copyright
              if yaInteresado
                span.text-success.d-flex.align-center.gap-2 ✓ Ya mostraste interés
              else
                form(action=`/publicacion/imagen/${imagen.id}/interesar` method="POST")
                  button.btn.btn-primary(type="submit") Me interesa adquirirla
          
        .card.card-content.mt-6
          h3.card-title.mb-4 Valoración
          if statsValoracion && statsValoracion.cantidad > 0
            p.text-body Promedio: <strong>#{statsValoracion.promedio} / 5</strong> (basado en #{statsValoracion.cantidad} votos)
          else if publicacion.nickUsuario != nickUsuario
            p.text-muted Sé el primero en valorar esta imagen.
          else
            p.text-muted Aún no hay valoraciones.

          if publicacion.nickUsuario != nickUsuario
            form(action=`/publicacion/imagen/${imagen.id}/valorar` method="POST")
              .d-flex.gap-2.mt-4
                button.btn.btn-secondary(type="submit" name="puntaje" value="1") 1 ⭐
                button.btn.btn-secondary(type="submit" name="puntaje" value="2") 2 ⭐
                button.btn.btn-secondary(type="submit" name="puntaje" value="3") 3 ⭐
                button.btn.btn-secondary(type="submit" name="puntaje" value="4") 4 ⭐
                button.btn.btn-secondary(type="submit" name="puntaje" value="5") 5 ⭐
        
        .mt-6
          .d-flex.justify-between.align-center.mb-4
            h3.section-title Comentarios
            if publicacion.nickUsuario == nickUsuario
              form(action=`/publicacion/imagen/${imagen.id}/toggle-comentarios` method="POST")
                input(type="hidden" name="comentariosActivos" value=imagen.comentariosActivos ? 'false' : 'true')
                button.btn.btn-secondary(type="submit") #{imagen.comentariosActivos ? 'Desactivar Comentarios' : 'Activar Comentarios'}

          if comentarios && comentarios.length > 0
            .comments-section
              each comentario in comentarios
                .comment
                  .comment-header
                    span.comment-author #{comentario.nickUsuario}
                    span.text-metadata #{new Date(comentario.createdAt).toLocaleDateString()}
                  p.comment-body.mt-2 #{comentario.texto}
                  if comentario.nickUsuario != publicacion.nickUsuario && comentario.nickUsuario != nickUsuario
                    form.mt-2(action=`/publicacion/comentario/${comentario.id}/denunciar` method="POST")
                      button.btn.btn-ghost.text-danger(type="submit", style="padding: 0; font-size: 13px;") Denunciar
          else
            .empty-state.mt-4
              p Aún no hay comentarios. ¡Sé el primero!

          if imagen.comentariosActivos
            form.mt-6(action=`/publicacion/imagen/${imagen.id}/comentar` method="POST")
              .form-group
                textarea.form-control(name="texto" rows="3" placeholder="Escribe tu comentario aquí..." required)
              button.btn.btn-primary.btn-block(type="submit") Enviar comentario
          else
            .alert.alert-danger.mt-6 Los comentarios están desactivados para esta imagen.