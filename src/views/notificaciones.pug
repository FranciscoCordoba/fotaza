extends layouts/app.pug

block content
  .d-flex.align-center.justify-between.mb-6
    h1.page-title Notificaciones de #{nickUsuario}
    a.btn.btn-secondary(href=`/usuario/perfil/${nickUsuario}`) Volver a mi perfil

  if notificaciones && notificaciones.length > 0
    .comments-section(style="max-width: 800px;")
      each noti in notificaciones
        .card(style=`margin-bottom: 12px; ${!noti.vista ? 'border-left: 4px solid var(--primary);' : ''}`)
          .card-content.d-flex.justify-between.align-center
            div
              p.text-metadata.mb-1= new Date(noti.createdAt).toLocaleDateString()
              p.text-body
                strong= noti.nickGeneracion 
                if noti.fuenteTipo === 'comentario'
                  |  ha comentado en tu publicación.
                else if noti.fuenteTipo === 'valoracion'
                  |  ha valorado tu publicación.
                else if noti.fuenteTipo === 'seguir'
                  |  ha comenzado a seguirte.
                else if noti.fuenteTipo.startsWith('strike:')
                  |  ha denunciado tu publicación (Motivo: #{noti.fuenteTipo.split(':')[1].trim()}). 
                  strong.text-danger (Se te ha sumado un strike)
                else if noti.fuenteTipo === 'interes'
                  |  ha mostrado interes en una de tus imágenes con copyright.
                else
                  |  interactuó contigo (#{noti.fuenteTipo}).
            div
              if !noti.vista
                form(action=`/usuario/notificaciones/${noti.id}/vista` method="POST")
                  button.btn.btn-primary(type="submit") Marcar como leída
              else
                span.text-success.text-metadata ✓ Leída
  else 
    .empty-state
      .empty-state-title Todo al día
      p.text-body No tienes ninguna notificación nueva.
