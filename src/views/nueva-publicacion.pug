extends layouts/app.pug

block content
  div(style="max-width: 720px; margin: 0 auto;")
    h1.page-title Subir publicación
    
    if error
      .alert.alert-danger= error
      
    .card
      .card-content(style="padding: 32px;")
        form(action="/publicacion/crear", method="POST", enctype="multipart/form-data")
          .form-group
            label.form-label(for="titulo") Título:
            input.form-control(type="text", name="titulo", id="titulo")
            
          .form-group
            label.form-label(for="descripcion") Descripción:
            input.form-control(type="text", name="descripcion", id="descripcion")
            
          .form-group
            label.form-label(for="imagenes") Imágenes (Máx 4MB en total):
            input.form-control(type="file", name="imagenes", multiple, accept="image/*", id="imagenes")
            
          .form-group
            label.form-label(for="etiquetas") Etiquetas (separadas por espacio y con #):
            input.form-control(type="text", name="etiquetas", id="etiquetas", placeholder="ej: #naturaleza #playa #sol")
            
          if comunidadesSigue && comunidadesSigue.length > 0
            .form-group
              label.form-label Compartir en comunidades:
              .card(style="padding: 16px; background-color: var(--surface-low); border-radius: 6px;")
                each comunidad in comunidadesSigue
                  .d-flex.align-center.gap-2(style="margin-bottom: 8px;")
                    input(type="checkbox", name="comunidades", value=comunidad.nickComunidad, id=`comunidad-${comunidad.nickComunidad}`)
                    label.text-body(for=`comunidad-${comunidad.nickComunidad}`)= comunidad.nickComunidad
          
          .mt-6
            button.btn.btn-primary(type="submit") Enviar