html 
    head 
        title Nueva Publicacion 

    body 
        h1 subir publicacion
        form(action="/publicacion/crear", method="POST", enctype="multipart/form-data")
            label(for="nickUsuario") Nickname:
            input(type="text", name="nickUsuario")
            br
            label(for="titulo") Titulo:
            input(type="text", name="titulo")
            br
            label(for="descripcion") Descripcion:
            input(type="text", name="descripcion")
            br
            label(for="imagenes") Imágenes:
            input(type="file", name="imagenes", multiple, accept="image/*")
            br
            label(for="etiquetas") Etiquetas (separadas por espacio y con #):
            input(type="text", name="etiquetas", placeholder="ej: #naturaleza #playa #sol")
            br
            button Enviar