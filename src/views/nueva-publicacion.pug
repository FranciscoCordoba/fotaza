html 
    head 
        title Nueva Publicacion 

    body 
        h1 subir publicacion
        if error
            p(style="color: red;")= error
        form(action="/publicacion/crear", method="POST", enctype="multipart/form-data")
            label(for="titulo") Titulo:
            input(type="text", name="titulo", id="titulo")
            br
            label(for="descripcion") Descripcion:
            input(type="text", name="descripcion", id="descripcion")
            br
            label(for="imagenes") Imágenes (Máx 4MB en total):
            input(type="file", name="imagenes", multiple, accept="image/*", id="imagenes")
            br
            label(for="etiquetas") Etiquetas (separadas por espacio y con #):
            input(type="text", name="etiquetas", id="etiquetas", placeholder="ej: #naturaleza #playa #sol")
            br
            if comunidadesSigue && comunidadesSigue.length > 0
                label Compartir en comunidades:
                br
                each comunidad in comunidadesSigue
                    input(type="checkbox", name="comunidades", value=comunidad.nickComunidad, id=`comunidad-${comunidad.nickComunidad}`)
                    label(for=`comunidad-${comunidad.nickComunidad}`)= comunidad.nickComunidad
                    br
            button Enviar