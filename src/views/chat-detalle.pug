html 
    head 
        title Chat con #{otroUsuario}
    body 
        h1 Chat con #{otroUsuario}
        a(href="/chat" style="display:inline-block; margin-bottom:15px;") Volver a mis chats
        
        div(style="border: 1px solid #ccc; padding: 15px; border-radius: 4px; max-width: 600px; height: 400px; overflow-y: scroll; margin-bottom: 15px;")
            if mensajes && mensajes.length > 0
                each msj in mensajes
                    - var esMio = msj.nickRemitente === nickUsuario
                    div(style=`margin-bottom: 10px; text-align: ${esMio ? 'right' : 'left'};`)
                        div(style=`display: inline-block; padding: 8px 12px; border-radius: 12px; background-color: ${esMio ? '#007bff' : '#f1f0f0'}; color: ${esMio ? 'white' : 'black'}; text-align: left; max-width: 80%;`)
                            p(style="margin: 0;") #{msj.contenido}
                            small(style=`color: ${esMio ? '#e0e0e0' : '#888'}; font-size: 0.75em; display: block; margin-top: 4px;`) #{new Date(msj.createdAt).toLocaleDateString()}
            else
                p No hay mensajes aún.

        form(action="/chat/" + chat.id + "/mensaje" method="POST")
            input(type="text", name="contenido", placeholder="Escribe un mensaje...", required, style="width: 400px; padding: 8px;")
            button(type="submit" style="padding: 8px 16px; background-color: #28a745; color: white; border: none; cursor: pointer; margin-left: 10px;") Enviar
