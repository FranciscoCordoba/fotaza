extends layouts/app.pug

block content
  .profile-header(style="margin-bottom: 24px; max-width: 800px;")
    .profile-info
      h1.page-title.mb-0 Chat con #{otroUsuario}
  
  .mb-4
    a.btn.btn-secondary(href="/chat") Volver a mis chats
  
  .card(style="max-width: 800px; margin-bottom: 24px;")
    .card-content(style="height: 500px; overflow-y: auto; display: flex; flex-direction: column; gap: 16px;")
      if mensajes && mensajes.length > 0
        each msj in mensajes
          - var esMio = msj.nickRemitente === nickUsuario
          div(style=`display: flex; flex-direction: column; align-items: ${esMio ? 'flex-end' : 'flex-start'};`)
            div(style=`padding: 12px 16px; border-radius: 12px; max-width: 80%; background-color: ${esMio ? 'var(--primary)' : 'var(--surface-high)'}; color: ${esMio ? '#fff' : 'var(--text)'};`)
              p.text-body.m-0 #{msj.contenido}
              small(style=`color: ${esMio ? 'rgba(255,255,255,0.7)' : 'var(--text-muted)'}; font-size: 11px; display: block; margin-top: 6px; text-align: right;`) #{new Date(msj.createdAt).toLocaleDateString()}
      else
        .empty-state(style="flex: 1; display: flex; flex-direction: column; justify-content: center; border: none;")
          .empty-state-title No hay mensajes aún.

  form(action=`/chat/${chat.id}/mensaje` method="POST" style="max-width: 800px;")
    .d-flex.gap-4
      input.form-control.flex-1(type="text", name="contenido", placeholder="Escribe un mensaje...", required)
      button.btn.btn-primary(type="submit") Enviar
