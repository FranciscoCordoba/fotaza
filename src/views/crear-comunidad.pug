extends layouts/app.pug

block content
  div(style="max-width: 720px; margin: 0 auto;")
    h1.page-title Crear una nueva comunidad
    
    if error
      .alert.alert-danger= error
      
    .card
      .card-content(style="padding: 32px;")
        form(action="/comunidad/crear", method="POST", enctype="multipart/form-data")
          .form-group
            label.form-label(for="nickComunidad") Nick de la Comunidad (único, ej: fotografia_digital):
            input.form-control(type="text", name="nickComunidad", id="nickComunidad")
            
          .form-group
            label.form-label(for="titulo") Título de la Comunidad:
            input.form-control(type="text", name="titulo", id="titulo")
            
          .form-group
            label.form-label(for="descripcion") Descripción:
            textarea.form-control(name="descripcion", id="descripcion", rows="4")
            
          .form-group
            label.form-label(for="normas") Normas de la Comunidad:
            textarea.form-control(name="normas", id="normas", rows="4")
            
          .form-group
            label.form-label(for="imagen") Imagen (Logo/Banner - Máx 4MB):
            input.form-control(type="file", name="imagen", accept="image/*", id="imagen")
            
          .mt-6
            button.btn.btn-primary(type="submit") Crear Comunidad
