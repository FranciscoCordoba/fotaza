extends layouts/auth

block content
  .auth-card
    h1.auth-brand Fotaza
    if error
      .alert.alert-danger= error
    form(action="/auth/login", method="POST")
      .form-group
        label.form-label(for="nickname") Nickname
        input.form-control(type="text", name="nickname", required)
      .form-group
        label.form-label(for="password") Contraseña
        input.form-control(type="password", name="password", required)
      
      button.btn.btn-primary.btn-block.mt-4(type="submit") Iniciar sesión
      
    .text-center.mt-4
      a.text-secondary(href="/auth/registro") No tengo cuenta (Registrarse)