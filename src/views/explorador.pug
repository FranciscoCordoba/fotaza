html 
    head 
        title Explorar contenido

    body 
        form(action="/publicacion/buscar", method="GET")
            input(type="text", name="busqueda", placeholder="Buscar")
            button Buscar 

        div
            div#publicaciones
                each publicacion in publicacionesConDatos
                    div 
                        h2= publicacion.titulo
                        p= publicacion.descripcion
                        div 
                            img(src=publicacion.imagen.url, alt=publicacion.titulo, style="width: 200px;")
                        div 
                            each etiqueta in publicacion.etiquetas
                                span(style="margin: 0 5px 0 0;")= "#" + etiqueta.etiqueta
                        a(href="/publicacion/p/" + publicacion.id + "/1", style="margin-top: 5px;") Ver publicacion
            //div#cuentas
            div#comunidades
                if comunidades && comunidades.length > 0
                    h1 Comunidades
                    each comunidad in comunidades
                        div(style="border: 1px solid #ccc; padding: 10px; margin-bottom: 10px;")
                            h2= comunidad.titulo
                            p
                                strong Nickname: 
                                | #{comunidad.nickComunidad}
                            if comunidad.descripcion
                                p= comunidad.descripcion
                            if comunidad.imagen
                                img(src=comunidad.imagen, alt=comunidad.titulo, style="width: 100px; display: block; margin-top: 5px; margin-bottom: 5px;")
                            button(onclick="window.location.href = '/comunidad/" + comunidad.nickComunidad + "'") Ir al perfil de la comunidad

        //aca deberian ir las PUBLICACIONES - CUENTAS - COMUNIDADES