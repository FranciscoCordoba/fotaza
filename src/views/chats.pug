html 
    head 
        title Mis Chats
    body 
        h1 Mis Chats
        a(href="/usuario/perfil/" + nickUsuario style="display:inline-block; margin-bottom:15px;") Volver a mi perfil
        
        if chats && chats.length > 0
            ul(style="list-style-type: none; padding: 0;")
                each chat in chats
                    - var otro = chat.nickUsuario1 === nickUsuario ? chat.nickUsuario2 : chat.nickUsuario1
                    li(style="margin-bottom: 10px; padding: 10px; border: 1px solid #ccc; border-radius: 4px;")
                        p(style="margin: 0;") Chat con 
                            strong 
                                a(href="/usuario/perfil/" + otro) #{otro}
                        a(href="/chat/" + chat.id style="display:inline-block; margin-top:10px;") Entrar al chat
        else 
            p No tienes conversaciones aún.
