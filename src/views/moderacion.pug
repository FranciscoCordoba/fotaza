extends layouts/app.pug

block content
  .d-flex.align-center.justify-between.mb-6
    h1.page-title Moderación de Comentarios
    a.btn.btn-secondary(href="/feed") Volver al Feed

  if denuncias && denuncias.length > 0
    .comments-section
      each item in denuncias
        .card.mb-4(style="max-width: 800px;")
          .card-content.d-flex.gap-6
            if item.imagen.url
              .card-image-wrapper(style="width: 150px; flex-shrink: 0; aspect-ratio: 1;")
                img.card-image(src=item.imagen.url, alt="Imagen reportada")
            .flex-1
              h3.card-title.mb-2 Publicación: #{item.publicacion.titulo}
              
              .mb-2
                p.text-body.mb-1
                  strong Comentario de #{item.comentario.nickUsuario}:
                p.text-body.mb-2 "#{item.comentario.texto}"
              
              .alert.alert-danger.mb-4(style="padding: 8px 12px; margin-bottom: 16px;")
                p.text-body.m-0
                  strong Denunciado por: 
                  | #{item.denuncia.nickUsuario} el #{new Date(item.denuncia.createdAt).toLocaleDateString()}
              
              .d-flex.gap-4
                form(action="/moderacion/desestimar", method="POST")
                  input(type="hidden", name="nickUsuario", value=item.denuncia.nickUsuario)
                  input(type="hidden", name="idComentario", value=item.comentario.id)
                  button.btn.btn-secondary(type="submit") Desestimar Denuncia
                
                form(action="/moderacion/eliminar", method="POST")
                  input(type="hidden", name="idComentario", value=item.comentario.id)
                  button.btn.btn-danger(type="submit") Eliminar Comentario
  else
    .empty-state.mb-6(style="max-width: 800px;")
      .empty-state-title No hay denuncias
      p.text-body No tienes comentarios denunciados en tus publicaciones en este momento.

  if rol === 'moderador' || rol === 'admin'
    h2.section-title.mt-6.mb-4 Moderación Global de Imágenes (Administración)

    if denunciasImagen && denunciasImagen.length > 0
      .comments-section
        each item in denunciasImagen
          .card.mb-4(style="max-width: 800px;")
            .card-content.d-flex.gap-6
              if item.imagen.url
                .card-image-wrapper(style="width: 150px; flex-shrink: 0; aspect-ratio: 1;")
                  img.card-image(src=item.imagen.url, alt="Imagen reportada")
              .flex-1
                h3.card-title.mb-4 Publicación: #{item.publicacion.titulo}
                
                .alert.alert-danger.mb-4(style="padding: 8px 12px;")
                  p.text-body.mb-1
                    strong Denunciada por: 
                    | #{item.denuncia.nickUsuario} el #{new Date(item.denuncia.createdAt).toLocaleDateString()}
                  p.text-body.mb-1
                    strong Motivo: 
                    | #{item.motivo.motivo}
                  if item.denuncia.descripcion
                    p.text-body.mb-1
                      strong Descripción: 
                      | #{item.denuncia.descripcion}
                  p.text-body.m-0
                    strong Estado actual: 
                    | #{item.denuncia.estado}

                if item.denuncia.estado === 'pendiente'
                  form.d-flex.gap-4.align-center(action="/moderacion/estado-imagen", method="POST")
                    input(type="hidden", name="nickUsuario", value=item.denuncia.nickUsuario)
                    input(type="hidden", name="idImagen", value=item.imagen.id)
                    select.form-control(name="estado", style="width: auto;")
                      option(value="pendiente", selected=item.denuncia.estado === 'pendiente') Pendiente
                      option(value="aceptada", selected=item.denuncia.estado === 'aceptada') Aceptada
                      option(value="rechazada", selected=item.denuncia.estado === 'rechazada') Rechazada
                    button.btn.btn-primary(type="submit") Actualizar Estado
                else
                  p.text-metadata Estado ya fue actualizado, no se puede modificar.
    else
      .empty-state(style="max-width: 800px;")
        .empty-state-title No hay imágenes reportadas
        p.text-body No hay imágenes denunciadas en el sistema.
