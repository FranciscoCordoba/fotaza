extends layouts/app.pug

block content
  .profile-header
    .profile-info
      h1.page-title.mb-0 Crear Nueva Colección para #{nickUsuario}

  if error
    .alert.alert-danger= error

  form(action="/usuario/colecciones/nueva" method="POST" style="max-width: 720px;")
    .form-group
      label.form-label(for="nombreColeccion") Nombre de la Colección:
      input.form-control(type="text" id="nombreColeccion" name="nombreColeccion" required)
    
    h3.section-title.mt-6 Publicaciones en 'Favoritos'
    p.text-body.mb-4 Selecciona las publicaciones que deseas agregar a la nueva colección:
    
    if publicacionesFav && publicacionesFav.length > 0
      .gallery-grid
        each pub in publicacionesFav
          label.card(style="cursor: pointer; display: block;")
            .card-content.d-flex.align-center.gap-2(style="padding-bottom: 0;")
              input(type="checkbox" name="publicaciones" value=pub.id)
              h4.card-title= pub.titulo
            if pub.imagen
              .card-image-wrapper.mt-4
                img.card-image(src=pub.imagen.url, alt=pub.titulo)
    else
      .alert.alert-danger No tienes publicaciones en Favoritos. Agrega alguna primero.
    
    .d-flex.gap-4.mt-6
      button.btn.btn-primary(type="submit") Guardar Colección
      a.btn.btn-secondary(href="/usuario/colecciones") Cancelar
